#=============================================================================#  # Multi-Protocol VIP Makefile  # Supports: Synopsys VCS, Cadence Xcelium, Siemens Questa  #=============================================================================#  SIMULATOR ?= vcs  TOP       ?= top_tb  TEST      ?= mp_random_regression_test  SEED      ?= $(shell date +%s)  UVM_HOME  ?= $(shell dirname $(shell which vcs))/../etc/uvm-1.2  SRC_DIRS  = ../vip/base ../vip/pcie ../vip/cxl ../vip/ucie ../vip/ualink ../rtl ../env ../sequences ../tests ../tb  INC_FLAGS = $(foreach d,$(SRC_DIRS),+incdir+$d)  SRC_FILES = ../vip/base/mp_vip_pkg.sv             ../vip/pcie/pcie_protocol_checker.sv             ../vip/cxl/cxl_protocol_checker.sv             ../vip/ucie/ucie_protocol_checker.sv             ../vip/ualink/ualink_protocol_checker.sv             ../rtl/mp_vip_if.sv             ../vip/base/mp_sequencer.sv             ../vip/base/mp_driver.sv             ../vip/base/mp_monitor.sv             ../vip/base/mp_agent.sv             ../env/mp_env.sv             ../sequences/mp_base_sequence.sv             ../sequences/mp_random_sequence.sv             ../sequences/mp_regression_sequence.sv             ../sequences/mp_power_mgmt_sequence.sv             ../sequences/mp_error_inject_sequence.sv             ../tests/mp_base_test.sv             ../tests/mp_random_regression_test.sv             ../tests/mp_pcie_gen5_test.sv             ../tests/mp_pcie_gen6_test.sv             ../tests/mp_cxl_test.sv             ../tests/mp_ucie_test.sv             ../tests/mp_ualink_test.sv             ../tests/mp_power_mgmt_test.sv             ../tests/mp_error_inject_test.sv             ../tb/top_tb.sv  ifeq ($(SIMULATOR),vcs)      COMPILE = vlogan -sverilog -ntb_opts uvm-1.2 $(INC_FLAGS)     ELAB    = vcs -sverilog -ntb_opts uvm-1.2 -timescale=1ns/1ps $(TOP) -o simv     RUN     = ./simv +UVM_TESTNAME=$(TEST) +ntb_random_seed=$(SEED) -l run.log  else ifeq ($(SIMULATOR),xcelium)      COMPILE = xmvlog -sv $(INC_FLAGS)     ELAB    = xmelab -access +rwc -timescale 1ns/1ps $(TOP)     RUN     = xmsim $(TOP) +UVM_TESTNAME=$(TEST) +ntb_random_seed=$(SEED) -l run.log  else ifeq ($(SIMULATOR),questa)      COMPILE = vlog -sv $(INC_FLAGS)     ELAB    = vsim -c $(TOP)     RUN     = vsim -c $(TOP) +UVM_TESTNAME=$(TEST) +ntb_random_seed=$(SEED) -do  run -all; quit  -l run.log  endif    .PHONY: all compile elaborate run clean regression  all: compile elaborate run  compile:         $(COMPILE) $(SRC_FILES)  elaborate:         $(ELAB)  run:         $(RUN)  regression:         @echo  Starting Multi-Protocol Regression Suite          @mkdir -p logs         @for test in mp_random_regression_test mp_pcie_gen5_test mp_pcie_gen6_test mp_cxl20_test mp_cxl30_test mp_ucie_test mp_ualink_test mp_power_mgmt_test mp_error_inject_test; do             for seed in 12345 67890 13579 24680 11111; do                 echo  Running $$test with seed $$seed ;                 $(MAKE) run TEST=$$test SEED=$$seed > logs/$$test_$$seed.log 2>&1;             done         done         @echo  Regression Complete. Check logs/ directory.   clean:         rm -rf simv simv.daidir csrc *.log vc_hdrs.h AN.DB xcelium.d work
# Coverage-driven regression (line/fsm/toggle/SVA assert, goal 100%)
-include coverage.mk
